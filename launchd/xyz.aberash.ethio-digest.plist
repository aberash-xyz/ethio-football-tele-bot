<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.aberash.ethio-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/bin/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <!-- 06:00 local time daily. launchd runs a missed job on wake, unlike cron. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/launchd.err.log</string>
</dict>
</plist>
