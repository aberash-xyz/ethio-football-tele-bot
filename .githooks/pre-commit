#!/bin/sh
# Refuse to commit secrets or the private corpus. Enable: git config core.hooksPath .githooks
bad=$(git diff --cached --name-only | grep -E '(^|/)\.env$|\.sqlite$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit private files:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  exit 1
fi
